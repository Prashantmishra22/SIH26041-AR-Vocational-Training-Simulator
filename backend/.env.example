# JH Safety AR — Backend Environment Variables
# Copy this file to .env and update values for your environment.

# Database (SQLite for development, PostgreSQL for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/jh_safety
DATABASE_URL=sqlite:///./jh_safety.db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Certificate verification base URL
CERTIFICATE_BASE_URL=http://localhost:8000
